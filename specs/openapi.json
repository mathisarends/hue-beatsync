{
  "openapi": "3.1.0",
  "info": {
    "title": "lichtorgel server",
    "description": "Start and stop a Hue entertainment Lichtorgel stream.",
    "version": "0.1.0"
  },
  "paths": {
    "/devices": {
      "get": {
        "summary": "List Devices",
        "description": "The audio inputs that can be passed as `device`.",
        "operationId": "list_devices",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AudioDeviceInfo"
                  },
                  "type": "array",
                  "title": "Response List Devices"
                }
              }
            }
          }
        }
      }
    },
    "/areas": {
      "get": {
        "summary": "List Areas",
        "description": "The Hue entertainment areas that can be passed as `area`.",
        "operationId": "list_areas",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AreaInfo"
                  },
                  "type": "array",
                  "title": "Response List Areas"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "summary": "Status",
        "operationId": "get_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/start": {
      "post": {
        "summary": "Start",
        "operationId": "start_sync",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncSettings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/stop": {
      "post": {
        "summary": "Stop",
        "operationId": "stop_sync",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/defaults": {
      "get": {
        "summary": "Get Defaults",
        "operationId": "get_defaults",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncSettings"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Set Defaults",
        "operationId": "set_defaults",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncSettings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncSettings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisSettings": {
        "properties": {
          "sensitivity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sensitivity"
          },
          "gamma": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gamma"
          },
          "floor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Floor"
          },
          "max_frequency": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Frequency"
          }
        },
        "type": "object",
        "title": "AnalysisSettings",
        "description": "How the signal is turned into loudness per frequency band."
      },
      "AreaInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          },
          "channels": {
            "type": "integer",
            "title": "Channels"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "active",
          "channels"
        ],
        "title": "AreaInfo",
        "description": "A Hue entertainment area, as accepted by the `area` setting (by `id` or\nby `name`)."
      },
      "AudioDeviceInfo": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "samplerate": {
            "type": "integer",
            "title": "Samplerate"
          },
          "channels": {
            "type": "integer",
            "title": "Channels"
          },
          "host_api": {
            "type": "string",
            "title": "Host Api"
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default"
          },
          "supports_exclusive": {
            "type": "boolean",
            "title": "Supports Exclusive"
          }
        },
        "type": "object",
        "required": [
          "index",
          "name",
          "samplerate",
          "channels",
          "host_api",
          "is_default",
          "supports_exclusive"
        ],
        "title": "AudioDeviceInfo",
        "description": "An audio input, as accepted by the `device` setting (by `index`, or by\nany part of `name`)."
      },
      "AudioSettings": {
        "properties": {
          "device": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device"
          },
          "exclusive": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exclusive"
          },
          "gain": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gain"
          }
        },
        "type": "object",
        "title": "AudioSettings",
        "description": "Where the sound comes from and how it is picked up."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "StatusResponse": {
        "properties": {
          "running": {
            "type": "boolean",
            "title": "Running"
          },
          "area": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Area"
          }
        },
        "type": "object",
        "required": [
          "running"
        ],
        "title": "StatusResponse"
      },
      "SyncSettings": {
        "properties": {
          "area": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Area"
          },
          "audio": {
            "$ref": "#/components/schemas/AudioSettings"
          },
          "analysis": {
            "$ref": "#/components/schemas/AnalysisSettings"
          },
          "visual": {
            "$ref": "#/components/schemas/VisualSettings"
          }
        },
        "type": "object",
        "title": "SyncSettings",
        "description": "Lichtorgel stream settings. Any field left unset falls back to a\nconfigured default (see /defaults), and then to the built-in default."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VisualSettings": {
        "properties": {
          "mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "rate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate"
          }
        },
        "type": "object",
        "title": "VisualSettings",
        "description": "How the analysis is painted onto the lights."
      }
    }
  }
}
